# Encrypts the ShipStation API key (a password field) at rest. Generate with:
#   npx @adobe/aio-commerce-lib-config encryption setup
AIO_COMMERCE_CONFIG_ENCRYPTION_KEY=

# Public key that verifies Commerce webhook signatures (Commerce Admin >
# Stores > Configuration > Adobe Services > Webhooks > Digital Signature).
COMMERCE_WEBHOOKS_PUBLIC_KEY=

# OAuth server-to-server credential the installation step uses to create the
# ShipStation carrier in Commerce.
AIO_COMMERCE_AUTH_IMS_CLIENT_ID=
AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=
AIO_COMMERCE_AUTH_IMS_ORG_ID=
AIO_COMMERCE_AUTH_IMS_SCOPES=
